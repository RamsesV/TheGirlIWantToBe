# Current clothing is independent of the chosen background.
default protagonist_outfit = "girl_next_door"


# Outfit is dynamic; pose and expression remain explicit.
image protagonist standing neutral = "images/characters/protagonist/[protagonist_outfit]/standing_neutral.png"


transform protagonist_left:
    xalign 0.22
    yalign 1.0

    zoom 0.70
    xzoom -1.0


transform protagonist_center:
    xalign 0.5
    yalign 1.0

    zoom 0.70
    xzoom 1.0


transform protagonist_right:
    xalign 0.78
    yalign 1.0

    zoom 0.70
    xzoom 1.0


transform protagonist_apartment_entry:
    xalign 0.93
    yalign 1.0

    zoom 0.70
    xzoom 1.0